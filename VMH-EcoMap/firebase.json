{
  "hosting": {
    "public": "pages",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**/*.xlsx",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(html|js|css|svg)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]
      }
    ]
  }
}
