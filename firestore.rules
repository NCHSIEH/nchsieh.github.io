rules_version = '2';

// =============================================================================
//  nchsieh-lms — Firestore Security Rules
//
//  這份規則是整個系統唯一真正的安全防線。
//  前端 JS 可以被任何人竄改，但這裡的判斷在 Google 伺服器上執行，繞不過去。
//
//  部署方式：Firebase Console → Firestore Database → 規則 → 全部貼上 → 發布
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 判斷函式 ----------

    function signedIn() {
      return request.auth != null;
    }

    // ---- 管理者名單 ----
    //
    // request.auth.token.email 來自 Firebase 簽發並簽章的 ID Token，
    // 前端無法偽造，因此用 Email 比對與查資料庫一樣安全，
    // 但省去在 Console 手動建立文件的麻煩。
    //
    // 要新增管理者：把 Email 加進下面陣列，重新發布規則，
    // 並同步更新 assets/js/config.js 的 ADMIN_EMAILS。
    function adminEmails() {
      return [
        'nchsieh@gmail.com'
      ];
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in adminEmails();
    }

    function studentDoc() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    // 已核准學生：必須同時滿足兩件事
    //   1. 已登入
    //   2. students 文件存在且 status == 'approved'（由管理者核准）
    // 注意：暫停中的學生 status 是 'suspended'，不是 'approved'，
    // 所以會自動被這裡擋下——暫停功能不需要額外的規則邏輯。
    //
    // 這裡刻意不要求 email_verified——因為驗證信常被學校信箱系統擋掉，
    // 造成學生完全卡關。小班制課程改由管理者手動核對姓名／學號／班級來把關，
    // 承擔「理論上有人可能冒用他人 Email 申請」這個極低機率的風險，換取
    // 「驗證信收不到就永遠進不來」這個更嚴重的實際問題不再發生。
    // （管理者帳號 isAdmin() 仍然要求 email_verified，因為那沒有人工審核這一關。）
    function isApprovedStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && studentDoc().status == 'approved';
    }

    // 課程存取範圍：students 文件的 allowedCourses 欄位若不存在或是空陣列，
    // 代表「不限制」，維持原本可看全部課程的行為；
    // 若有內容，則只有列在其中的課程可以讀取講義與作業。
    function canAccessCourse(courseId) {
      return !('allowedCourses' in studentDoc())
        || studentDoc().allowedCourses.size() == 0
        || courseId in studentDoc().allowedCourses;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }


    // ---------- 學生帳號與審核狀態 ----------
    match /students/{uid} {

      // 本人可讀自己的狀態；管理者可讀全部
      allow get:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 註冊時由本人建立，但狀態強制寫死為 pending，
      // 而且 email 必須與登入憑證一致，無法冒用他人身分建檔。
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['email', 'name', 'studentId', 'className', 'note', 'status', 'createdAt']
           );

      // 本人只能補填姓名、學號、班級與備註，改不動 status——這是審核機制的關鍵。
      // order（顯示順序）與 allowedCourses（可看課程範圍）只有管理者能寫。
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && unchanged('status')
            && unchanged('email')
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['name', 'studentId', 'className', 'note']));

      allow delete: if isAdmin();
    }


    // ---------- 課程 ----------
    // 課程大綱公開：讓搜尋引擎與潛在學生看得到你開什麼課。
    match /courses/{courseId} {
      allow read:  if true;
      allow write: if isAdmin();

      // 講義清單只給已核准、且這門課在其可看範圍內的修課學生。
      // 未核准、被暫停、或這門課不在 allowedCourses 範圍內的學生，連檔名與路徑都拿不到。
      match /materials/{materialId} {
        allow read:  if (isApprovedStudent() && canAccessCourse(courseId)) || isAdmin();
        allow write: if isAdmin();
      }

      // 作業與截止日同上
      match /assignments/{assignmentId} {
        allow read:  if (isApprovedStudent() && canAccessCourse(courseId)) || isAdmin();
        allow write: if isAdmin();
      }
    }


    // ---------- 公告 ----------
    match /announcements/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ---------- 全站設定（版型／配色預設） ----------
    // 任何人都能讀（公開頁需要在載入時套用），只有管理者能寫。
    match /settings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ---------- 著作論文 ----------
    match /publications/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ---------- 研究計畫與獲獎 ----------
    match /projects/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }


    // ---------- 其餘一律拒絕 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
